# ==============================================================================
# Environment Variables Configuration for Raisa Profil (Rey-prof)
# ==============================================================================
# Di Vercel: Dashboard -> Project -> Settings -> Environment Variables
# Pastikan dicentang untuk environment: Production, Preview, Development.
# JANGAN menggunakan prefix VITE_ untuk credential sensitif!

# ADMIN_PASWORD_REY (WAJIB):
# Password / PIN rahasia untuk otentikasi login admin Rey (tap nama REY 5x).
# Atur dengan password yang kuat dan aman.
ADMIN_PASWORD_REY=your_secure_admin_password_here

# ADMIN_SECRET (OPSIONAL):
# Secret key 32+ karakter untuk menandatangani HMAC session token.
# Jika tidak diisi, server akan menghasilkan signing key yang konsisten dari ADMIN_PASWORD_REY.
ADMIN_SECRET=

# VERCEL KV / UPSTASH REDIS (OPSIONAL - UNTUK PENYIMPANAN PROFILE PERMANEN DI VERCEL):
# Di Vercel Dashboard -> Storage -> Create "KV" Database -> Connect to project "Rey-prof".
# Vercel akan otomatis mengisi variable di bawah ini:
KV_REST_API_URL=
KV_REST_API_TOKEN=
